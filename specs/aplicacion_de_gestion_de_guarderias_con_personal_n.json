        "repository_port": [
          "save",
          "findById",
          "findByChild",
          "updateContactInfo"
        ]
      },
      "Staff": {
        "attributes": [
          "firstName",
          "lastName",
          "role",
          "hireDate",
          "status",
          "qualifications"
        ],
        "repository_port": [
          "save",
          "findById",
          "findByRole",
          "updateStatus"
        ]
      },
      "Classroom": {
        "attributes": [
          "name",
          "capacity",
          "ageGroup",
          "teacherId",
          "assistantId"
        ],
        "repository_port": [
          "save",
          "findById",
          "findByAgeGroup",
          "assignStaff"
        ]
      },
      "Attendance": {
        "attributes": [
          "childId",
          "classroomId",
          "checkInTime",
          "checkOutTime",
          "date",
          "notes"
        ],
        "repository_port": [
          "save",
          "findById",
          "findByChildAndDate",
          "recordCheckOut"
        ]
      },
      "Payment": {
        "attributes": [
          "guardianId",
          "childId",
          "amount",
          "dueDate",
          "paymentDate",
          "status",
          "paymentMethod",
          "invoiceNumber"
        ],
        "repository_port": [
          "save",
          "findById",
          "findByGuardian",
          "findOverdue",
          "updateStatus"
        ]
      },
      "Invoice": {
        "attributes": [
          "invoiceNumber",
          "guardianId",
          "childId",
          "items",
          "totalAmount",
          "issueDate",
          "dueDate",
          "status"
        ],
        "repository_port": [
          "save",
          "findById",
          "findByGuardian",
          "generateInvoice",
          "updateStatus"
        ]
      }
    },
    "value_objects": [
      "ChildId",
      "GuardianId",
      "StaffId",
      "ClassroomId",
      "AttendanceId",
      "PaymentId",
      "InvoiceId",
      "Address",
      "Money",
      "DateRange",
      "ContactInfo"
    ],
    "enums": {
      "ChildStatus": [
        "ENROLLED",
        "WAITLISTED",
        "WITHDRAWN",
        "GRADUATED"
      ],
      "StaffRole": [
        "TEACHER",
        "ASSISTANT",
        "ADMINISTRATOR",
        "JANITOR",
        "COOK"
      ],
      "AttendanceStatus": [
        "PRESENT",
        "ABSENT",
        "LATE",
        "EXCUSED"
      ],
      "PaymentStatus": [
        "PENDING",
        "PAID",
        "OVERDUE",
        "CANCELLED"
      ],
      "InvoiceStatus": [
        "DRAFT",
        "ISSUED",
        "PAID",
        "OVERDUE",
        "VOID"
      ]
    },
    "key_use_cases": [
      "Enroll a new child in the daycare",
      "Assign a child to a classroom based on age group",
      "Record daily attendance for children",
      "Generate monthly invoices for guardians",
      "Process payments from guardians",
      "Manage staff assignments to classrooms",
      "Update child information (allergies, special needs)",
      "Handle guardian contact information updates",
      "Track overdue payments and send reminders",
      "Generate reports on attendance, payments, and classroom occupancy"
    ]
  },
  "architecture": {
    "architecture_overview": "The DaycareManagementSystem is designed using a Hexagonal Architecture (Ports and Adapters) to ensure separation of concerns, testability, and maintainability. The core domain is isolated from external concerns like persistence and web frameworks. The structure is organized into three main layers: Domain (core business logic and entities), Application (use cases and services), and Infrastructure (external implementations like JPA and REST controllers). Each entity (Child, Guardian, Staff, Classroom, Attendance, Payment, Invoice) follows a consistent pattern with domain models, repository ports, value objects for IDs, application services and DTOs, and infrastructure adapters. Maven is used for build management with JUnit 5 and Mockito for testing. The system is containerized with Docker and includes a main application class for Spring Boot startup.",
