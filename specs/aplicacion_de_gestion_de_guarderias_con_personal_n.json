        "repository_port": [
          "save",
          "findById",
          "findAll",
          "update",
          "delete"
        ]
      }
    },
    "value_objects": [
      "ChildId",
      "StaffId",
      "PaymentId",
      "AttendanceId",
      "ClassroomId",
      "Money",
      "Address",
      "ContactInfo",
      "DateRange"
    ],
    "enums": {
      "ChildStatus": [
        "ENROLLED",
        "WAITLISTED",
        "WITHDRAWN",
        "GRADUATED"
      ],
      "StaffRole": [
        "TEACHER",
        "ASSISTANT",
        "ADMINISTRATOR",
        "JANITOR",
        "COOK"
      ],
      "PaymentStatus": [
        "PENDING",
        "PAID",
        "OVERDUE",
        "CANCELLED"
      ],
      "PaymentMethod": [
        "CASH",
        "CARD",
        "BANK_TRANSFER",
        "CHECK"
      ],
      "AttendanceStatus": [
        "PRESENT",
        "ABSENT",
        "LATE",
        "EXCUSED"
      ]
    },
    "key_use_cases": [
      "Enroll a new child in the daycare",
      "Register a new staff member",
      "Record daily attendance for children",
      "Generate and process monthly payments",
      "Assign children to classrooms based on age",
      "Update child information (allergies, contacts)",
      "Manage staff schedules and roles",
      "Generate reports on attendance and payments",
      "Handle late pickups and incident reports",
      "Process refunds or payment adjustments"
    ]
  },
  "architecture": {
    "architecture_overview": "This Hexagonal Architecture (Ports and Adapters) for DaycareManagement isolates the core business logic (Domain) from external concerns like persistence and web interfaces. The Domain layer contains Entities, Value Objects, and Repository Ports defining business rules and interfaces. The Application layer orchestrates use cases via Services and defines Data Transfer Objects (DTOs) for external communication. The Infrastructure layer implements adapters: JPA entities and repositories for persistence (using Hibernate/Spring Data JPA) and REST Controllers (using Spring MVC) for web exposure. Testing is emphasized with unit tests for Domain models and application service tests. Maven manages dependencies (Spring Boot, JUnit 5, Mockito), and Docker enables containerization. This structure ensures maintainability, testability, and flexibility to swap external components.",
