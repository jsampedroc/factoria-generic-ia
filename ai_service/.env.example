DEEPSEEK_API_KEY=replace_me
AI_MODEL=deepseek-chat
AI_BASE_URL=https://api.deepseek.com
AI_TEMPERATURE=0.1

# Modes: http, kafka, both
AI_MODE=both

# Kafka (if enabled)
KAFKA_BOOTSTRAP=redpanda:9092
KAFKA_TOPIC_JOBS=ai.jobs
KAFKA_TOPIC_RESULTS=ai.results
KAFKA_TOPIC_DLQ=ai.dlq
KAFKA_GROUP_ID=ai-workers

# Feature flags
FEATURE_STRICT_JSON=true
FEATURE_RETRY_ON_INVALID_JSON=true
FEATURE_REQUIRE_HUMAN_APPROVAL=true

# Observability
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
OTEL_SERVICE_NAME=factoria-ai
