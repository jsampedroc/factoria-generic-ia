{
  "bounded_contexts": [
    {
      "name": "Core",
      "description": "Contexto principal que gestiona la lógica central del sistema SaaS industrial"
    },
    {
      "name": "Analytics",
      "description": "Contexto dedicado al procesamiento y análisis de datos industriales"
    },
    {
      "name": "Maintenance",
      "description": "Contexto para la gestión de mantenimiento predictivo y correctivo"
    }
  ],
  "entities": [
    {
      "name": "Factory",
      "attributes": [
        {
          "name": "factoryId",
          "type": "UUID"
        },
        {
          "name": "name",
          "type": "String"
        },
        {
          "name": "location",
          "type": "String"
        },
        {
          "name": "status",
          "type": "FactoryStatus"
        }
      ]
    },
    {
      "name": "Machine",
      "attributes": [
        {
          "name": "machineId",
          "type": "UUID"
        },
        {
          "name": "serialNumber",
          "type": "String"
        },
        {
          "name": "model",
          "type": "String"
        },
        {
          "name": "installationDate",
          "type": "DateTime"
        },
        {
          "name": "operationalStatus",
          "type": "MachineStatus"
        }
      ]
    },
    {
      "name": "ProductionOrder",
      "attributes": [
        {
          "name": "orderId",
          "type": "UUID"
        },
        {
          "name": "productCode",
          "type": "String"
        },
        {
          "name": "quantity",
          "type": "Integer"
        },
        {
          "name": "priority",
          "type": "OrderPriority"
        },
        {
          "name": "status",
          "type": "OrderStatus"
        }
      ]
    }
  ],
  "aggregates": [
    {
      "name": "FactoryAggregate",
      "root_entity": "Factory",
      "entities": ["Machine", "ProductionOrder"]
    },
    {
      "name": "MaintenanceAggregate",
      "root_entity": "MaintenanceTask",
      "entities": ["Machine", "Technician"]
    }
  ],
  "value_objects": [
    {
      "name": "SensorReading",
      "attributes": [
        {
          "name": "value",
          "type": "Float"
        },
        {
          "name": "unit",
          "type": "String"
        },
        {
          "name": "timestamp",
          "type": "DateTime"
        }
      ]
    },
    {
      "name": "QualityMetric",
      "attributes": [
        {
          "name": "metricName",
          "type": "String"
        },
        {
          "name": "threshold",
          "type": "Float"
        },
        {
          "name": "actualValue",
          "type": "Float"
        }
      ]
    },
    {
      "name": "Address",
      "attributes": [
        {
          "name": "street",
          "type": "String"
        },
        {
          "name": "city",
          "type": "String"
        },
        {
          "name": "postalCode",
          "type": "String"
        },
        {
          "name": "country",
          "type": "String"
        }
      ]
    }
  ],
  "domain_events": [
    {
      "name": "MachineStarted",
      "attributes": [
        {
          "name": "machineId",
          "type": "UUID"
        },
        {
          "name": "timestamp",
          "type": "DateTime"
        },
        {
          "name": "operatorId",
          "type": "UUID"
        }
      ]
    },
    {
      "name": "ProductionOrderCompleted",
      "attributes": [
        {
          "name": "orderId",
          "type": "UUID"
        },
        {
          "name": "completedAt",
          "type": "DateTime"
        },
        {
          "name": "totalProduced",
          "type": "Integer"
        }
      ]
    },
    {
      "name": "MaintenanceAlertRaised",
      "attributes": [
        {
          "name": "alertId",
          "type": "UUID"
        },
        {
          "name": "machineId",
          "type": "UUID"
        },
        {
          "name": "severity",
          "type": "AlertSeverity"
        },
        {
          "name": "description",
          "type": "String"
        }
      ]
    }
  ],
  "use_cases": [
    {
      "name": "MonitorMachineHealth",
      "description": "Supervisa el estado de salud de una máquina en tiempo real"
    },
    {
      "name": "ScheduleProductionOrder",
      "description": "Programa una nueva orden de producción en el sistema"
    },
    {
      "name": "GenerateMaintenanceReport",
      "description": "Genera un informe de mantenimiento para un período específico"
    }
  ],
  "business_rules": [
    {
      "name": "MachineSafetyShutdown",
      "description": "Apagado automático de la máquina si los sensores superan umbrales críticos de seguridad"
    },
    {
      "name": "ProductionPriorityRule",
      "description": "Las órdenes de alta prioridad deben programarse antes que las de baja prioridad"
    },
    {
      "name": "MaintenanceThresholdRule",
      "description": "Programar mantenimiento preventivo cuando el desgaste de la máquina alcanza el 80%"
    }
  ]
}